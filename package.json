{
  "name": "folio-reader",
  "productName": "Folio",
  "version": "0.10.1",
  "description": "Leitor EPUB local e open source com conversa sobre livros",
  "type": "module",
  "main": "electron/main.cjs",
  "license": "MIT",
  "author": "Folio contributors",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5178",
    "desktop": "npm run build && electron .",
    "build": "tsc --noEmit && vite build",
    "test": "node scripts/test.mjs",
    "package:mac": "npm run build && electron-packager . Folio --platform=darwin --arch=arm64 --out=release --overwrite --ignore='^/(release|tests|research|src|node_modules/.cache)(/|$)' --icon=public/folio.icns --app-bundle-id=org.folio.reader",
    "android:build": "bash scripts/build-android.sh"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.92",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "ai": "^7.0.138",
    "epubjs": "^0.3.93",
    "idb-keyval": "^6.2.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@electron/packager": "^20.3.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.7.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  },
  "overrides": {
    "@xmldom/xmldom": "0.9.12",
    "uuid": "11.1.1"
  }
}
